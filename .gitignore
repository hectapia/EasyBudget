# --- Kotlin/Java Compilation ---
# Ignore the directory where .class files are stored
bin/
# Ignore the final JAR file (it should be built from source, not stored)
*.jar
*.kotlin_module

# --- Database ---
# Ignore the SQLite database file and temporary journal files
# This prevents your personal budget data from being uploaded to GitHub
data/*.db
data/*.db-journal
data/*.db-shm
data/*.db-wal

# --- VS Code & IDEs ---
# Ignore local workspace settings
.vscode/
.history/
*.log

# --- Operating System ---
# Windows thumbnail cache and folder settings
Thumbs.db
desktop.ini
# macOS folder attributes
.DS_Store

# --- Build Tools (If you use them later) ---
.gradle/
build/
target/